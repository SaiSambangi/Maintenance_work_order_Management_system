              "raw": "{\n  \"workOrderNumber\": \"WO-PM-2026-001\",\n  \"assetId\": 2,\n  \"maintenanceTypeId\": 1,\n  \"description\": \"Routine 12,000-hour generator overhaul and fuel filter flush\",\n  \"priority\": \"HIGH\",\n  \"assignedTechnicianId\": 2,\n  \"scheduledDate\": \"2026-10-30\",\n  \"status\": \"OPEN\"\n}"
