    {
      "name": "4. Work Orders (Standard Operations)",
      "item": [
        {
          "name": "GET All Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        },
        {
          "name": "GET Filter by Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders?status=OPEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"],
              "query": [
                {
                  "key": "status",
                  "value": "OPEN"
                }
              ]
            }
          }
        },
        {
          "name": "GET Filter by Combined Criteria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders?status=OPEN&priority=HIGH&asset_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"],
              "query": [
                {
                  "key": "status",
                  "value": "OPEN"
                },
                {
                  "key": "priority",
                  "value": "HIGH"
                },
                {
                  "key": "asset_id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "GET Work Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders", "1"]
            }
          }
        },
