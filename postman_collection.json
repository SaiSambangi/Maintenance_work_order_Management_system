    },
    {
      "name": "5. Business Rules Enforcement (Expected Rejections)",
      "item": [
        {
          "name": "Rule 1: Duplicate Work Order Number (Expects 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderNumber\": \"WO-TEST-100\",\n  \"assetId\": 1,\n  \"maintenanceTypeId\": 1,\n  \"description\": \"Duplicate WO number attempt\",\n  \"priority\": \"LOW\",\n  \"scheduledDate\": \"2026-10-25\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        },
        {
          "name": "Rule 2: CRITICAL Without Assigned Technician (Expects 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderNumber\": \"WO-FAIL-CRIT\",\n  \"assetId\": 1,\n  \"maintenanceTypeId\": 1,\n  \"description\": \"Emergency fault with no assigned technician\",\n  \"priority\": \"CRITICAL\",\n  \"assignedTechnicianId\": null,\n  \"scheduledDate\": \"2026-10-25\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        },
        {
          "name": "Rule 5: Scheduled Date in Past (Expects 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderNumber\": \"WO-FAIL-DATE\",\n  \"assetId\": 1,\n  \"maintenanceTypeId\": 1,\n  \"description\": \"Trying to set scheduled date in the past\",\n  \"priority\": \"MEDIUM\",\n  \"assignedTechnicianId\": 1,\n  \"scheduledDate\": \"2020-01-01\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        },
        {
          "name": "Rule 6: OUT_OF_SERVICE Asset with Non-Emergency Type (Expects 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderNumber\": \"WO-FAIL-OOS\",\n  \"assetId\": 5,\n  \"maintenanceTypeId\": 1,\n  \"description\": \"Asset 5 is OUT_OF_SERVICE but Type 1 is Preventive (not emergency)\",\n  \"priority\": \"HIGH\",\n  \"assignedTechnicianId\": 1,\n  \"scheduledDate\": \"2026-10-25\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        },
        {
          "name": "Rule 6 Success: OUT_OF_SERVICE Asset WITH Emergency Type (Expects 201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workOrderNumber\": \"WO-OK-EMERG-001\",\n  \"assetId\": 5,\n  \"maintenanceTypeId\": 3,\n  \"description\": \"Asset 5 is OUT_OF_SERVICE and Type 3 is Emergency Repair (Allowed!)\",\n  \"priority\": \"CRITICAL\",\n  \"assignedTechnicianId\": 1,\n  \"scheduledDate\": \"2026-10-25\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "work-orders"]
            }
          }
        }
      ]
