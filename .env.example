# =====================================================================
# Maintenance Work Order Management System - Environment Template
# =====================================================================
# Copy this file to '.env' or set these environment variables in your OS/IDE.
# NEVER commit your actual '.env' file containing real secrets to GitHub.
# =====================================================================

# ---------------------------------------------------------------------
# Backend Database Configuration (MySQL)
# ---------------------------------------------------------------------
# Supported by application.properties (as DB_URL/DB_USER/DB_PASSWORD or
# standard Spring Boot SPRING_DATASOURCE_* format)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maintenance_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JDBC URL used by Spring Boot:
DB_URL=jdbc:mysql://localhost:3306/maintenance_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# ---------------------------------------------------------------------
# Backend Server Configuration
# ---------------------------------------------------------------------
SERVER_PORT=8080

# ---------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
